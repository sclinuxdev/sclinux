# tools/build.py always overrides this with the digest from seed.lock.toml.
ARG SEED_IMAGE=invalid.invalid/stage0-seed-must-be-pinned
FROM ${SEED_IMAGE}

ARG APT_PACKAGES
ARG DEBIAN_SNAPSHOT
ARG DEBIAN_SUITE
ARG SOURCE_DATE_EPOCH
ARG SAGE_URL
ARG SAGE_SHA256

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    TZ=UTC \
    XMAKE_ROOT=y \
    XMAKE_STATS=false

RUN set -eu; \
    test -n "${APT_PACKAGES}"; \
    test -n "${DEBIAN_SNAPSHOT}"; \
    test -n "${DEBIAN_SUITE}"; \
    printf '%s\n' \
        'Types: deb' \
        "URIs: http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}" \
        "Suites: ${DEBIAN_SUITE}" \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp' \
        > /etc/apt/sources.list.d/debian.sources; \
    printf '%s\n' \
        'Acquire::Check-Valid-Until false;' \
        'Acquire::Retries "5";' \
        'Acquire::http::Pipeline-Depth "0";' \
        > /etc/apt/apt.conf.d/99snapshot; \
    apt-get update; \
    for attempt in 1 2 3 4 5; do \
        if DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ${APT_PACKAGES}; then \
            break; \
        fi; \
        test "${attempt}" -lt 5; \
        sleep "$((attempt * 2))"; \
    done; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

COPY Stage1/recipes/sage/sage-reproducible-archives.patch /tmp/sage-reproducible-archives.patch

RUN set -eu; \
    test -n "${SAGE_URL}"; \
    test -n "${SAGE_SHA256}"; \
    curl --fail --location --retry 4 --output /tmp/sage.tar.gz "${SAGE_URL}"; \
    printf '%s  %s\n' "${SAGE_SHA256}" /tmp/sage.tar.gz | sha256sum --check --strict; \
    mkdir /tmp/sage-src; \
    tar -xzf /tmp/sage.tar.gz --strip-components=1 -C /tmp/sage-src; \
    cd /tmp/sage-src; \
    patch -p1 < /tmp/sage-reproducible-archives.patch; \
    xmake f -c -m release -y; \
    xmake -y; \
    xmake install -o /usr -y; \
    /usr/bin/sage --version; \
    rm -rf /tmp/sage-src /tmp/sage.tar.gz /tmp/sage-reproducible-archives.patch

WORKDIR /build
